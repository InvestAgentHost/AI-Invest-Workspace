# Secrets and machine-local configuration
.env
.env.*
config.json
config.yaml
*.local.json
credentials.json
secrets.json
secrets.yaml
secrets.yml
*.key
*.pem
*.p12

# Local runtime
.local/
.auth/
.cache/
.pytest_cache/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.log
*.tmp
/tmp

# IDE, Obsidian and operating systems
.obsidian/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# All acquired source material is local-only and transferred as a folder.
sources/**
!sources/.gitkeep

# Company-local external material moved alongside research reports.
research/companies/**/_file/

# Rebuildable company-research intake and preprocessing artifacts.
# Keep durable report Markdown at the company directory root tracked.
research/companies/**/data/**
# ResearchFoundry runtime roots are rebuildable and must not appear as report changes.
# Raw external files remain under sources/; durable conclusions remain at the company root.
research/companies/**/artifacts/**
research/companies/**/runs/**
research/companies/**/cache/**
research/companies/**/logs/**
research/companies/**/state/**
research/companies/**/targets/**

# Rebuildable data and knowledge products
data/curated/**
data/derived/**
knowledge/indexes/**
knowledge/databases/**
!knowledge/indexes/README.md
!knowledge/databases/README.md

# Generated deliverables and temporary intake
outputs/**
!outputs/README.md
inbox/**
!inbox/README.md

# Large local formats are never added outside sources by accident.
*.pdf
*.PDF
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.parquet
*.feather
*.arrow
*.sqlite
*.sqlite3
*.duckdb
*.db
*.faiss
*.index
*.pkl
*.pickle
*.joblib

# Exception: company Excel model deliverables (source-of-truth workbooks) are
# durable research output and should be tracked in git, unlike other binary
# formats above.
!research/companies/**/outputs/**/*.xlsx
!research/companies/**/*.docx
