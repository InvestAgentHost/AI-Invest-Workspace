{
  "$defs": {
    "QuantitativeChartSeries": {
      "additionalProperties": false,
      "description": "One ordered series selected from bound model inputs.",
      "properties": {
        "input_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Ids",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "input_ids"
      ],
      "title": "QuantitativeChartSeries",
      "type": "object"
    },
    "QuantitativeChartSpec": {
      "additionalProperties": false,
      "description": "A report-ready chart generated from explicit model input IDs.",
      "properties": {
        "chart_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
          "title": "Chart Id",
          "type": "string"
        },
        "chart_type": {
          "enum": [
            "line",
            "column"
          ],
          "title": "Chart Type",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/QuantitativeChartSeries"
          },
          "minItems": 1,
          "title": "Series",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "chart_id",
        "title",
        "chart_type",
        "unit",
        "series"
      ],
      "title": "QuantitativeChartSpec",
      "type": "object"
    },
    "QuantitativeCheckSpec": {
      "additionalProperties": false,
      "description": "A deterministic linear reconciliation declared by the research Agent.",
      "properties": {
        "category": {
          "enum": [
            "segment_reconciliation",
            "cash_bridge",
            "formula",
            "scenario",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "check_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
          "title": "Check Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Expected Value"
        },
        "perimeter": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perimeter"
        },
        "period": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/QuantitativeCheckTerm"
          },
          "minItems": 2,
          "title": "Terms",
          "type": "array"
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Tolerance"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "check_id",
        "category",
        "description",
        "terms"
      ],
      "title": "QuantitativeCheckSpec",
      "type": "object"
    },
    "QuantitativeCheckTerm": {
      "additionalProperties": false,
      "description": "One coefficient and input in a declared linear model identity.",
      "properties": {
        "coefficient": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Coefficient"
        },
        "input_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
          "title": "Input Id",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "coefficient"
      ],
      "title": "QuantitativeCheckTerm",
      "type": "object"
    }
  },
  "$id": "urn:research_foundry:schema:quantitative_model_spec:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent-authored model purpose, checks, and chart selections.",
  "properties": {
    "charts": {
      "items": {
        "$ref": "#/$defs/QuantitativeChartSpec"
      },
      "minItems": 1,
      "title": "Charts",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/QuantitativeCheckSpec"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "model_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
      "title": "Model Id",
      "type": "string"
    },
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "research_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
      "title": "Research Id",
      "type": "string"
    },
    "schema_version": {
      "const": "quantitative_model_spec.v1",
      "default": "quantitative_model_spec.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "model_id",
    "research_id",
    "purpose",
    "checks",
    "charts"
  ],
  "title": "QuantitativeModelSpec",
  "type": "object"
}
