{
  "$defs": {
    "PanelSourceRef": {
      "additionalProperties": false,
      "description": "One exact registered-source locator used by a panel value.",
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
          "title": "Source Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "start_line",
        "end_line"
      ],
      "title": "PanelSourceRef",
      "type": "object"
    },
    "ResearchPanelRow": {
      "additionalProperties": false,
      "description": "One semantically adjudicated metric across panel periods.",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
          "title": "Metric Id",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/ResearchPanelValue"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "metric_id",
        "label",
        "scope",
        "values"
      ],
      "title": "ResearchPanelRow",
      "type": "object"
    },
    "ResearchPanelValue": {
      "additionalProperties": false,
      "description": "One period value with explicit disclosure and comparability state.",
      "properties": {
        "formula": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "period": {
          "minLength": 1,
          "title": "Period",
          "type": "string"
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PanelSourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "status": {
          "enum": [
            "reported",
            "derived",
            "not_disclosed",
            "not_comparable",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "period",
        "status"
      ],
      "title": "ResearchPanelValue",
      "type": "object"
    }
  },
  "$id": "urn:research_foundry:schema:research_panel:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Auditable metric-by-period panel without research conclusions.",
  "properties": {
    "comparability_notes": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Comparability Notes",
      "type": "array"
    },
    "default_unit": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Unit"
    },
    "missing_periods": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Periods",
      "type": "array"
    },
    "panel_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
      "title": "Panel Id",
      "type": "string"
    },
    "panel_type": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
      "title": "Panel Type",
      "type": "string"
    },
    "periods": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Periods",
      "type": "array"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ResearchPanelRow"
      },
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "research_panel.v1",
      "default": "research_panel.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "panel_id",
    "panel_type",
    "title",
    "periods",
    "rows"
  ],
  "title": "ResearchPanel",
  "type": "object"
}
