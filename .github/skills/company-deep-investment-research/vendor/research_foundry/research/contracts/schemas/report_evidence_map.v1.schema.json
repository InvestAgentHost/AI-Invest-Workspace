{
  "$defs": {
    "ReportEvidenceBlock": {
      "additionalProperties": false,
      "description": "Evidence bindings for one stable final-report block.",
      "properties": {
        "block_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
          "title": "Block Id",
          "type": "string"
        },
        "block_kind": {
          "enum": [
            "heading",
            "prose",
            "table",
            "list",
            "other"
          ],
          "title": "Block Kind",
          "type": "string"
        },
        "panel_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReportPanelRef"
          },
          "title": "Panel Refs",
          "type": "array"
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReportEvidenceSourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "topic_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
          "title": "Topic Id",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "topic_id",
        "block_kind"
      ],
      "title": "ReportEvidenceBlock",
      "type": "object"
    },
    "ReportEvidenceSourceRef": {
      "additionalProperties": false,
      "description": "One report-block source locator and its evidentiary role.",
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "evidence_role": {
          "default": "support",
          "enum": [
            "support",
            "context",
            "management_attribution",
            "calculation_input"
          ],
          "title": "Evidence Role",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
          "title": "Source Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "start_line",
        "end_line"
      ],
      "title": "ReportEvidenceSourceRef",
      "type": "object"
    },
    "ReportPanelRef": {
      "additionalProperties": false,
      "description": "One final-report block dependency on a quantitative panel.",
      "properties": {
        "metric_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Metric Ids",
          "type": "array"
        },
        "panel_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
          "title": "Panel Id",
          "type": "string"
        },
        "periods": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Periods",
          "type": "array"
        }
      },
      "required": [
        "panel_id",
        "metric_ids",
        "periods"
      ],
      "title": "ReportPanelRef",
      "type": "object"
    }
  },
  "$id": "urn:research_foundry:schema:report_evidence_map:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hidden traceability from a clean report to sources and panels.",
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/ReportEvidenceBlock"
      },
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "draft_ref": {
      "default": "notes/report_draft.md",
      "minLength": 1,
      "title": "Draft Ref",
      "type": "string"
    },
    "draft_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Sha256",
      "type": "string"
    },
    "report_ref": {
      "default": "report.md",
      "minLength": 1,
      "title": "Report Ref",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "research_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
      "title": "Research Id",
      "type": "string"
    },
    "schema_version": {
      "const": "report_evidence_map.v1",
      "default": "report_evidence_map.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "writer_ref": {
      "minLength": 1,
      "title": "Writer Ref",
      "type": "string"
    }
  },
  "required": [
    "research_id",
    "report_sha256",
    "draft_sha256",
    "writer_ref",
    "blocks"
  ],
  "title": "ReportEvidenceMap",
  "type": "object"
}
