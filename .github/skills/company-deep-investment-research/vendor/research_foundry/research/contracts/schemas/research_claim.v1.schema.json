{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Exact lines in one immutable artifact below the user workspace.",
      "properties": {
        "artifact_ref": {
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "artifact_ref",
        "artifact_sha256",
        "start_line",
        "end_line"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "$id": "urn:research_foundry:schema:research_claim:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One material claim handed to another package or the final report.",
  "properties": {
    "claim_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$",
      "title": "Claim Id",
      "type": "string"
    },
    "claim_type": {
      "enum": [
        "fact",
        "calculation",
        "interpretation",
        "forecast"
      ],
      "title": "Claim Type",
      "type": "string"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "counterevidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Counterevidence",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "perimeter": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Perimeter"
    },
    "period": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period"
    },
    "schema_version": {
      "const": "research_claim.v1",
      "default": "research_claim.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    }
  },
  "required": [
    "claim_id",
    "statement",
    "claim_type",
    "evidence",
    "confidence"
  ],
  "title": "ResearchClaim",
  "type": "object"
}
